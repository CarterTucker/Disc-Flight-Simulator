    20.0  26.0  0.4675216   1.0120970   0.07549327
    20.0  30.0  0.4665795   1.0108290   0.07534001

    25.0   8.0  0.6255410   1.1610230   0.09430410
    25.0  14.0  0.6240202   1.1592940   0.09159505
    25.0  20.0  0.6225974   1.1577540   0.09039917
    25.0  26.0  0.6216271   1.1572870   0.08993737
    25.0  30.0  0.6212831   1.1571150   0.08971204
];

aero.alpha_deg = unique(aero.data(:,1));   % [0; 10; 20]
aero.U_grid    = unique(aero.data(:,2));   % [10; 20; 30]

nAlpha = length(aero.alpha_deg);
nU     = length(aero.U_grid);

aero.CD_grid = reshape(aero.data(:,3), nU, nAlpha)';
aero.CL_grid = reshape(aero.data(:,4), nU, nAlpha)';
aero.CM_grid = reshape(aero.data(:,5), nU, nAlpha)';


%% Environmental Conditions
env.g      = 9.81;              % m/s^2
env.rho    = 1.225;             % air density, kg/m^3
env.wind_v = [0 0 0];           % wind velocity in earth axes, m/s


%% Throw Conditions
x0 = [0; 0; 1.0];               % release 1m above ground
v0 = 29;                        % m/s

roll0_deg  = -5;                 % deg
pitch0_deg = 3;                 % deg (nose angle in vertical plane)
yaw0_deg = 0;                   % deg (initial launch direction offset)

r0 = 1500;                    % rpm (spin rate; negative is CW)
p0 = 0;
q0 = 0;

% convert degrees to radians
phi0 = deg2rad(roll0_deg);
theta0 = deg2rad(pitch0_deg);
psi0 = deg2rad(yaw0_deg);
r0 = pi*r0/30;

% translational pitch
throw_force_angle = deg2rad(5);

% initial spin vector
euler0 = [phi0; theta0; psi0];

euler_test = [0; 0; pi/2];
q_test = euler2quat(euler_test);
T_from_quat = T12_from_quat(q_test);
T_from_euler = T12_matrix(euler_test);
disp(T_from_quat - T_from_euler);

% initial velocity vector
u_earth0 = [v0*cos(throw_force_angle); 0; v0*sin(throw_force_angle)];           % all initial speed along disc x-axis
T12_0   = T12_matrix(euler0);

% initial body-axis angular rates
angvel0 = [p0; q0; r0];


%% Simulation Settings
tspan = [0 3];
opts = odeset('Events', @(t,y) ground_event(t,y), 'RelTol', ...
    1e-4, 'AbsTol', 1e-6, 'MaxStep', 0.005, 'OutputFcn', @(t,y,flag) progress_print(t,y,flag));

% initial states (quaternion)
q0 = euler2quat(euler0);
y0 = [x0; u_earth0; q0; angvel0];

%% Simulation Solver (fixed-step RK4)
dt = 0.001;                      % seconds per step
N  = ceil(diff(tspan)/dt) + 1;

y_hist = zeros(13, N);
t_hist = zeros(1, N);

disc_velo = zeros(3, N);
disc_accel = zeros(3, N);
disc_angvelo = zeros(4, N);
disc_angaccel = zeros(3, N);
disc_p = zeros(1, N);
disc_q = zeros(1, N);
disc_r = zeros(1, N);

y_hist(:,1) = y0;
t_hist(1)   = tspan(1);

for i = 1:N-1
    yi = y_hist(:,i);
    ti = t_hist(i);

    k1 = disc_eom(ti,        yi,          disc, aero, env);
    k2 = disc_eom(ti+dt/2,   yi+dt/2*k1,  disc, aero, env);
    k3 = disc_eom(ti+dt/2,   yi+dt/2*k2,  disc, aero, env);
    k4 = disc_eom(ti+dt,     yi+dt*k3,    disc, aero, env);

    y_next = yi + dt/6*(k1 + 2*k2 + 2*k3 + k4);
    y_next(7:10) = y_next(7:10) / norm(y_next(7:10));   % renormalize quaternion

    y_hist(:,i+1) = y_next;
    t_hist(i+1)   = ti + dt;

    [~, diag] = disc_eom(ti + dt, y_next, disc, aero, env);
    disc_velo(:,i)     = diag.velo;
    disc_accel(:,i)    = diag.accel;
    disc_angvelo(:,i)  = diag.angvelo;
    disc_angaccel(:,i) = diag.angaccel;
    disc_p(i) = diag.p;
    disc_q(i) = diag.q;
    disc_r(i) = diag.r;

    if y_next(3) <= 0
        y_hist = y_hist(:,1:i+1);
        t_hist = t_hist(1:i+1);
        break
    end

end

t = t_hist';
y = y_hist';        % transpose so downstream plotting code (y(:,1:3) etc.) still works unchanged

%% The actual physics...
function [dydt, diag] = disc_eom(~, y, disc, aero, env)
    
    %% Initial States (quaternion)
    u1 = y(4:6);

    q = y(7:10);
    q = q / norm(q);

    angvel = y(11:13);

    u1_rel = u1 - env.wind_v(:);

    %% Rotation Matrices
    T12 = T12_from_quat(q);
    u2  = T12 * u1_rel;

    beta = -atan2(u2(2), u2(1));    % zero sideslip angle
    T23  = T23_matrix(beta);        % disc axes -> zero-sideslip axes
    u3   = T23 * u2;

    alpha = -atan2(u3(3), u3(1));   % rad, angle of attack
    alpha_deg = rad2deg(alpha);
    T34   = T34_matrix(alpha);      % zero-sideslip axes -> wind axes

    T14 = T34 * T23 * T12;
    T41 = T14';

    %% Aerodynamic Coefficient Interpolation
    Vrel_for_lookup = norm(u1_rel); 
    Vlookup = min(max(Vrel_for_lookup, min(aero.U_grid)), max(aero.U_grid));
    Alookup = min(max(alpha_deg, min(aero.alpha_deg)), max(aero.alpha_deg));

    CL = interp2(aero.U_grid, aero.alpha_deg, aero.CL_grid, ...
             Vlookup, Alookup, 'linear');
    CD = interp2(aero.U_grid, aero.alpha_deg, aero.CD_grid, ...
                 Vlookup, Alookup, 'linear');
    CM = interp2(aero.U_grid, aero.alpha_deg, aero.CM_grid, ...
                 Vlookup, Alookup, 'linear');

    fprintf('alpha = %.3f deg, V = %.2f, CM = %.4f, q = %.3f\n', ...
        alpha_deg, Vrel_for_lookup, CM, angvel(2));

    %% Forces in Wind Axes
    Vrel = norm(u1_rel);
    q_dyn = 0.5 * env.rho * Vrel^2;

    F_drag = q_dyn * CD * disc.S;
    F_lift = q_dyn * CL * disc.S;
    
    F4 = [-F_drag; 0; F_lift];
    
    g1 = [0; 0; -disc.m * env.g];       % gravity in Earth axis
    g4 = T14 * g1;          % gravity from Earth axis to wind axis

    F4_total = F4 + g4;                 % add the lift, drag, and gravity forces

    %% Roll Rate Equations
    Clp = -0.001;
    CMq = -0.01;
    
    Mx = q_dyn * disc.S * disc.D * Clp * angvel(1) * disc.D / (2*Vrel);
    My = q_dyn * disc.S * disc.D * ...
         (CM + CMq * angvel(2) * disc.D / (2*Vrel));
    Mz = 0;
    % Mx = 0;
    % My = 0.01;
    % Mz = 0;
    M_disc = T23' * T34' * [Mx; My; Mz];  % moments in wind axes to disc axes
    % M_disc = [Mx; My; Mz];  % moments in wind axes to disc axes

    angvel_dot = [(M_disc(1) - angvel(2)*angvel(3)*(disc.Iz - disc.Ixy))/disc.Ixy; ...
                  (M_disc(2) + angvel(3)*angvel(1)*(disc.Iz - disc.Ixy))/disc.Ixy; ...
                  M_disc(3)/disc.Iz];

    % fprintf('My = %.6f, Mdisc = [%.6f %.6f %.6f]\n', ...
    % My, M_disc(1), M_disc(2), M_disc(3));
    fprintf('alpha = %.3f, CL = %.4f, CD = %.4f, CM = %.4f, My = %.5f, p = %.3f, q = %.3f, r = %.3f\n', ...
    alpha_deg, CL, CD, CM, My, angvel(1), angvel(2), angvel(3));
   
    %% Attitude Rate
    omega_pure = [0; angvel];
    % q_dot = -0.5 * quat_multiply(omega_pure, q);
    q_dot = 0.5 * quat_multiply(q, omega_pure);

    %% Convert Wind Axes Forces and Moments to Earth Axes
    F1  = T41 * F4_total;               % lift, drag, and gravity
    accel = F1 / disc.m;

    %% Construct the derivative (quaternion)
    dydt = zeros(13,1);
    dydt(1:3) = u1;              % velocity
    dydt(4:6) = accel;           % acceleration
    dydt(7:10) = q_dot;       % angular velocity
    dydt(11:13) = angvel_dot;    % angular acceleration

    diag.velo = u1;
    diag.accel = accel;
    diag.angvelo = q_dot;
    diag.angaccel = angvel_dot;
    diag.p = angvel(1);
    diag.q = angvel(2);
    diag.r = angvel(3);

end


%% 3D Plotting
pos = y(:,1:3)*3.28084;
figure('Name','Disc golf trajectory (3D)');
plot3(pos(:,1), pos(:,2), pos(:,3), 'LineWidth', 2, 'Color', [0.85 0.33 0.10]);
%comet3(pos(:,1), pos(:,2), pos(:,3));
hold on;

% Mark release and landing points
plot3(pos(1,1), pos(1,2), pos(1,3), 'o', 'MarkerSize', 7, ...
      'MarkerFaceColor', [0.10 0.60 0.35], 'MarkerEdgeColor', 'k');
plot3(pos(end,1), pos(end,2), pos(end,3), 'o', 'MarkerSize', 7, ...
      'MarkerFaceColor', [0.55 0.10 0.10], 'MarkerEdgeColor', 'k');

% Faint ground-projection curve (x-y path traced at z = 0) for depth cues
plot3(pos(:,1), pos(:,2), zeros(size(pos,1),1), '--', ...
      'LineWidth', 0.75, 'Color', [0.6 0.6 0.6]);

xlabel('Downrange Distance, x (ft)');
ylabel('Drift, y (ft)');
zlabel('Height, z (ft)');
title('3D flight trajectory');
legend({'Flight path','Release','Landing','Ground projection'}, ...
       'Location', 'best');
xlim([-10, 90]);
lim = max(abs(ylim)); ylim([-lim, lim])

grid on;
axis equal;
view(-115, 45);
hold off;


%% Print Debugging Data
debug = [disc_velo; disc_accel; disc_angvelo; disc_angaccel];
[~, l] = size(t_hist);
figure;
plot(t_hist, disc_p(1:l));
hold on;
plot(t_hist, disc_q(1:l));
plot(t_hist, disc_r(1:l));
legend('p','q','r');
grid on;
xlabel('Time (s)');
ylabel('Angular rate (rad/s)');

disc_p(1:3)
disc_q(1:3)
disc_r(1:3)

disc_p(l-3:l-1)
disc_q(l-3:l-1)
disc_r(l-3:l-1)

%% Rotation Matrix Functions
function T = T12_matrix(euler)
    phi   = euler(1);
    theta = euler(2);
    psi   = euler(3);
    
    T = [ cos(theta)*cos(psi), ...
          sin(phi)*sin(theta)*cos(psi) - cos(phi)*sin(psi), ...
          cos(phi)*sin(theta)*cos(psi) + sin(phi)*sin(psi); ...
          ...
          cos(theta)*sin(psi), ...
          sin(phi)*sin(theta)*sin(psi) + cos(phi)*cos(psi), ...
          cos(phi)*sin(theta)*sin(psi) - sin(phi)*cos(psi); ...
          ...
          -sin(theta), ...
          sin(phi)*cos(theta), ...
          cos(phi)*cos(theta) ];
end

function T = T23_matrix(beta)
    T = [ cos(beta), -sin(beta), 0; ...
          sin(beta),  cos(beta), 0; ...
          0,          0,         1 ];
end

function T = T34_matrix(alpha)
    T = [ cos(alpha), 0, -sin(alpha); ...
          0,          1,  0; ...
          sin(alpha), 0,  cos(alpha) ];
end

function [value, isterminal, direction] = ground_event(~, y)
    value      = y(3);      % z position; triggers when this hits 0
    isterminal = 1;         % stop the integration
    direction  = -1;        % the disc is falling
end

function status = progress_print(t, y, flag)
    status = 0;
    if isempty(flag) && ~isempty(t)
        fprintf('t = %.4f, z = %.3f, |q| = %.6f\n', t(end), y(3,end), norm(y(7:10,end)));
        fprintf('t=%.5f  q=[%.4f %.4f %.4f %.4f]\n', t(end), y(7,end), y(8,end), y(9,end), y(10,end));
    end
end

% quaternion functions
function q = euler2quat(euler)
    phi   = euler(1);
    theta = euler(2);
    psi   = euler(3);

    cphi = cos(phi/2);   sphi = sin(phi/2);
    cth  = cos(theta/2); sth  = sin(theta/2);
    cpsi = cos(psi/2);   spsi = sin(psi/2);

    q0 = cphi*cth*cpsi + sphi*sth*spsi;
    q1 = sphi*cth*cpsi - cphi*sth*spsi;
    q2 = cphi*sth*cpsi + sphi*cth*spsi;
    q3 = cphi*cth*spsi - sphi*sth*cpsi;

    q = [q0; q1; q2; q3];
end

function T = T12_from_quat(q)
    q0 = q(1); q1 = q(2); q2 = q(3); q3 = q(4);

    T = [ q0^2+q1^2-q2^2-q3^2,   2*(q1*q2 - q0*q3),     2*(q1*q3 + q0*q2); ...
          2*(q1*q2 + q0*q3),     q0^2-q1^2+q2^2-q3^2,   2*(q2*q3 - q0*q1); ...
          2*(q1*q3 - q0*q2),     2*(q2*q3 + q0*q1),     q0^2-q1^2-q2^2+q3^2 ];
end

function c = quat_multiply(a, b)
    a0 = a(1); a1 = a(2); a2 = a(3); a3 = a(4);
    b0 = b(1); b1 = b(2); b2 = b(3); b3 = b(4);

    c0 = a0*b0 - a1*b1 - a2*b2 - a3*b3;
    c1 = a0*b1 + a1*b0 + a2*b3 - a3*b2;
    c2 = a0*b2 - a1*b3 + a2*b0 + a3*b1;
    c3 = a0*b3 + a1*b2 - a2*b1 + a3*b0;

    c = [c0; c1; c2; c3];
end

function euler = quat2euler(q)
    q0 = q(1); q1 = q(2); q2 = q(3); q3 = q(4);

    phi   = atan2(2*(q0*q1 + q2*q3), 1 - 2*(q1^2 + q2^2));
    theta = asin(max(-1, min(1, 2*(q0*q2 - q3*q1))));   % clamp for numerical safety near +-90 deg
    psi   = atan2(2*(q0*q3 + q1*q2), 1 - 2*(q2^2 + q3^2));

    euler = [phi; theta; psi];
end